---
layout: layouts/base.njk
title: Research
permalink: /research/index.html
---
{# Lists are built at build time from src/assets/xml/research.xml (see src/_data/research.js). #}
<div class="research-root">
<nav class="section-nav" aria-label="Sections">
  {% for section in research.sections %}<a href="#{{ section.id }}-heading">{{ section.title }}</a>{% endfor %}
</nav>
{% for section in research.sections %}
  <section class="research-section" aria-labelledby="{{ section.id }}-heading">
    <h2 id="{{ section.id }}-heading" class="section-title-lg">{{ section.title }}</h2>
    <div class="section-underline"></div>
    <div id="{{ section.id }}" class="section-list fade-in">
    {% for item in section.items %}
      {% if item.abstract %}
      <details class="paper" id="{{ item.id }}">
        <summary class="paper-toggle" role="button" aria-expanded="false">
          <div class="paper-main">
            <span class="paper-title-inline">{{ item.citation | safe }}</span>
            {% if item.media %}<div class="paper-media"><span class="paper-media__label">In the media</span>{{ item.media | safe }}</div>{% endif %}
          </div>
          <span class="chev2" aria-hidden="true"></span>
        </summary>
        <div class="abstract-wrap">
          <div class="abstract-card">
            <div class="abstract-body">{{ item.abstract | safe }}</div>
            {% if item.doc or item.appendix or item.replication or item.doiUrl %}
            <div class="abs-actions">
              {% if item.doc %}
              <a class="btn btn-abs" href="{{ item.doc }}" target="_blank" rel="noopener">
                <svg class="icon-feather" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="15" x2="15" y2="15"/><line x1="9" y1="11" x2="11.5" y2="11"/><line x1="13" y1="11" x2="15" y2="11"/>
                </svg><span>Paper</span>
              </a>
              {% endif %}
              {% if item.appendix %}
              <a class="btn btn-abs" href="{{ item.appendix }}" target="_blank" rel="noopener">
                <svg class="icon-feather" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/>
                </svg><span>Appendix</span>
              </a>
              {% endif %}
              {% if item.replication %}
              <a class="btn btn-abs" href="{{ item.replication }}" target="_blank" rel="noopener">
                <svg class="icon-feather" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
                </svg><span>Replication package</span>
              </a>
              {% endif %}
              {% if item.doiUrl %}
              <a class="btn btn-abs" href="{{ item.doiUrl }}" target="_blank" rel="noopener">
                <svg class="icon-feather" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
                </svg><span>Journal version</span>
              </a>
              {% endif %}
            </div>
            {% endif %}
          </div>
        </div>
      </details>
      {% else %}
      <div class="paper no-abstract" id="{{ item.id }}">
        <div class="paper-toggle">
          <div class="paper-main">
            <span class="paper-title-inline">{{ item.citation | safe }}</span>
            {% if item.media %}<div class="paper-media"><span class="paper-media__label">In the media</span>{{ item.media | safe }}</div>{% endif %}
          </div>
        </div>
      </div>
      {% endif %}
    {% endfor %}
    </div>
  </section>
{% endfor %}
</div>

<script src="/assets/js/research.js"></script>
