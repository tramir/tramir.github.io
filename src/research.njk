---
layout: layouts/base.njk
title: Research
permalink: /research/index.html
---
{# Lists are built at build time from src/assets/xml/research.xml (see src/_data/research.js). #}
<div class="research-root">
{% for section in research.sections %}
  <section class="research-section" aria-labelledby="{{ section.id }}-heading">
    <h2 id="{{ section.id }}-heading" class="section-title-lg">{{ section.title }}</h2>
    <div class="section-underline"></div>
    <div id="{{ section.id }}" class="section-list fade-in">
    {% for item in section.items %}
      {% if item.abstract %}
      <details class="paper" id="{{ item.id }}">
        <summary class="paper-toggle" role="button" aria-expanded="false">
          <span class="paper-title-inline">{{ item.citation | safe }}</span>
          <span class="chev2" aria-hidden="true"></span>
        </summary>
        <div class="abstract-wrap">
          <div class="abstract-card">
            <div class="abstract-body">{{ item.abstract | safe }}</div>
            {% if item.doc or item.replication %}
            <div class="abs-actions">
              {% if item.doc %}
              <a class="btn btn-abs btn-doc" href="{{ item.doc }}" target="_blank" rel="noopener">
                <svg class="icon-feather" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14 2 14 8 20 8"/>
                  <line x1="9" y1="15" x2="15" y2="15"/>
                  <line x1="9" y1="11" x2="11.5" y2="11"/>
                  <line x1="13" y1="11" x2="15" y2="11"/>
                </svg><span>Paper</span>
              </a>
              {% endif %}
              {% if item.replication %}
              <a class="btn btn-abs btn-rep" href="{{ item.replication }}" target="_blank" rel="noopener">
                <svg class="icon-feather" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="16 18 22 12 16 6"></polyline>
                  <polyline points="8 6 2 12 8 18"></polyline>
                </svg><span>Replication package</span>
              </a>
              {% endif %}
            </div>
            {% endif %}
          </div>
        </div>
      </details>
      {% else %}
      <div class="paper no-abstract" id="{{ item.id }}">
        <div class="paper-toggle">
          <span class="paper-title-inline">{{ item.citation | safe }}</span>
        </div>
      </div>
      {% endif %}
    {% endfor %}
    </div>
  </section>
{% endfor %}
</div>

<script src="/assets/js/research.js"></script>
